# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,draftly.software,.up.railway.app

# Database — choose one of the two options below:

# Option A: Supabase managed Postgres (production)
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string → URI
# Use the "Transaction" pooler URL (port 6543) for Django/gunicorn (PgBouncer-compatible)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Option B: local Postgres via docker compose --profile localdb (development)
DB_NAME=rfp_db
DB_USER=rfp_user
DB_PASSWORD=rfp_pass
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Frontend / API URLs
VITE_API_URL=https://draftly-production-56bf.up.railway.app

# Sentry
# Create two Sentry projects: React for frontend, Django for backend.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SEND_DEFAULT_PII=False
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

# CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://draftly.software,https://www.draftly.software,http://localhost:5173,http://127.0.0.1:5173

# Admin IP gate — comma-separated IPs/CIDRs allowed to reach /admin/. Empty disables.
ADMIN_IP_ALLOWLIST=
# Number of trusted reverse proxies in front of Django. 0 = direct (use REMOTE_ADDR).
# Railway/Vercel edge typically = 1. Required for XFF to be trusted by the admin gate.
ADMIN_TRUSTED_PROXY_COUNT=0

# Google OAuth — Sign in with Google
# Create an OAuth 2.0 Client ID at: https://console.cloud.google.com/apis/credentials
# Type: Web application. Add http://localhost:5173 as an authorised JS origin.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# AI Keys — required
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic Claude — primary LLM provider
# Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_ENABLED=True

# Cohere Rerank — optional, free trial tier: 1000 calls/month
# Get key: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0
RERANK_ENABLED=True
RERANK_FETCH_TOP_K=50
RERANK_KEEP_TOP_K=10

# Frontend URL — used for Stripe checkout/portal redirects.
# Must be the public origin of the SPA, no trailing slash.
FRONTEND_URL=http://localhost:5173

# Stripe — required for billing
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get from: https://dashboard.stripe.com/test/webhooks (or `stripe listen` CLI for local dev)
STRIPE_WEBHOOK_SECRET=whsec_...
# Pin the Stripe API version so behavior is stable across SDK upgrades.
STRIPE_API_VERSION=2024-11-20.acacia
# Create Products + Prices in Stripe dashboard, copy the price_... IDs here
STRIPE_PRICE_SOLO_MONTHLY=price_...
STRIPE_PRICE_SOLO_ANNUAL=price_...
STRIPE_PRICE_STUDIO_MONTHLY=price_...
STRIPE_PRICE_STUDIO_ANNUAL=price_...
STRIPE_PRICE_AGENCY_MONTHLY=price_...
STRIPE_PRICE_AGENCY_ANNUAL=price_...

# File storage
# Set True in production to use Supabase Storage; False uses local /media/ directory
USE_SUPABASE_STORAGE=False

# Supabase Storage (S3-compatible) — required when USE_SUPABASE_STORAGE=True
# Get keys from: Supabase Dashboard → Project → Settings → Storage → S3 Access Keys
# SUPABASE_STORAGE_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_STORAGE_BUCKET=documents
# SUPABASE_STORAGE_ACCESS_KEY=<s3-access-key>
# SUPABASE_STORAGE_SECRET_KEY=<s3-secret-key>
# SUPABASE_STORAGE_REGION=us-east-1
